{
	"name": "pro-api-sdk",
	"type": "module",
	"version": "1.6.4",
	"description": "JLCEDA & EasyEDA Professional Extension API Development Toolkit",
	"author": "JLCEDA",
	"license": "Apache-2.0",
	"homepage": "https://pro.lceda.cn/",
	"bin": {
		"create-easyeda-api-sdk": "./build/create.js"
	},
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ && tsx ./config/esbuild.prod.ts",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && tsx ./build/packaged.ts",
		"debug": "tsx ./build/dev.ts",
		"update:check": "tsx ./build/update.ts check",
		"update": "tsx ./build/update.ts update && npm install",
		"manifest:generate": "npm install && tsx ./build/manifest.ts generate",
		"manifest:bump": "npm install && tsx ./build/manifest.ts bump && npm install",
		"test": "node tests/audit.logic.test.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.3.13",
		"@types/fs-extra": "^11.0.4",
		"@types/ws": "^8.5.13",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jsdom": "^29.1.1",
		"jszip": "^3.10.1",
		"lint-staged": "^16.2.3",
		"rimraf": "^6.0.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.9",
		"typescript": "^5.7.3",
		"ws": "^8.18.0"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	}
}
